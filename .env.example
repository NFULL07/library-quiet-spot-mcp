DATA4LIBRARY_AUTH_KEY=replace_with_issued_key
KAKAO_REST_API_KEY=optional_for_place_name_search
ALADIN_TTB_KEY=optional_for_bookstore_metadata
PORT=3000
CACHE_TTL_SECONDS=21600
CACHE_STALE_TTL_SECONDS=86400
CACHE_MAX_ENTRIES=500
REQUEST_TIMEOUT_MS=5000
LOG_LEVEL=info
UPSTREAM_MAX_ATTEMPTS=2
UPSTREAM_RETRY_BASE_MS=150
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RESET_MS=30000
